# HealthBridge Environment Configuration (Safe Placeholders)
# -------------------------------------------------------------
# NEVER put live credentials, database connection strings, or production secrets in this file.

# Application Information
VITE_APP_NAME="HealthBridge Telemedicine"
VITE_APP_ENV="production"
VITE_APP_VERSION="1.0.0"

# Target Regional Deployment Context
VITE_DEFAULT_REGION="Nabha, Punjab"
VITE_CIVIL_HOSPITAL_CODE="PB-PTA-NABHA-01"

# Remote API Gateway (Leave blank or set to your deployed backend URL)
# Example: https://api.healthbridge-nabha.in
VITE_API_BASE_URL=""

# Teleconsultation Provider (Optional WebRTC Signaling / Managed Service)
# When empty, HealthBridge operates in local media preview & resilient audio/chat fallback mode
VITE_WEBRTC_SIGNALING_URL=""
VITE_STUN_SERVER="stun:stun.l.google.com:19302"

# In-App Emergency Contacts
VITE_EMERGENCY_NATIONAL="112"
VITE_EMERGENCY_AMBULANCE="108"
